# Arachne Environment Variables (Example)
#
# Copy this file to .env and fill in your values — .env is loaded
# automatically at startup (variables already set in your real environment
# still win). Every key below mirrors config/default.toml; the app reads TOML
# first and lets ARACHNE_-prefixed environment variables override it. Nested
# keys use a double underscore:
#   [database].url  ->  ARACHNE_DATABASE__URL
# Values shown here match the shipped defaults unless commented otherwise.

# --- Messaging (NATS JetStream) -------------------------------------------
# Client port of the docker-compose NATS service (host 4223 -> container 4222).
ARACHNE_NATS__URL=nats://127.0.0.1:4223

# --- Storage backend --------------------------------------------------------
# "postgres" is the recommended default; "scylla" is the legacy opt-in
# (docker-compose profile "legacy-scylla"; also set ARACHNE_SCYLLA__URI and
# ARACHNE_SCYLLA__KEYSPACE for that mode).
ARACHNE_DATABASE__BACKEND=postgres

# PostgreSQL connection string for the default backend.
ARACHNE_DATABASE__URL=postgres://arachne:arachne@127.0.0.1:5432/arachne

# Connection-pool ceiling.
ARACHNE_DATABASE__MAX_CONNECTIONS=10

# --- Worker -----------------------------------------------------------------
# Global in-flight request cap per worker.
ARACHNE_WORKER__MAX_CONCURRENT_REQUESTS=512

# Descriptive User-Agent; archive.org's Bots policy additionally requires a
# contact address inside it or via ARACHNE_CONTACT below.
ARACHNE_WORKER__USER_AGENT="ArachneBot/2.0 (+https://github.com/Noel-Alex/Arachne)"

# --- Politeness -------------------------------------------------------------
# Default delay between requests to the same domain when robots.txt is silent.
ARACHNE_POLITENESS__DEFAULT_CRAWL_DELAY_MS=250

# --- Media storage ----------------------------------------------------------
# Directory for downloaded audio/video/document files.
ARACHNE_MEDIA__STORE_DIR=./media_store

# Total disk budget for stored media, in bytes. 0 = unlimited.
ARACHNE_MEDIA__MAX_TOTAL_BYTES=0

# --- Metrics ----------------------------------------------------------------
# Prometheus scrape endpoint (/metrics): served by both binaries.
ARACHNE_METRICS__ENABLED=true

# Port for the worker's /metrics endpoint; the coordinator serves +1 (9192).
ARACHNE_METRICS__PORT=9191

# --- Harvest sources --------------------------------------------------------
# Jamendo API key from https://developer.jamendo.com (or --jamendo-client-id).
JAMENDO_CLIENT_ID=

# Contact address required by archive.org's Bots policy (or --contact).
ARACHNE_CONTACT=you@example.com

# --- Monitoring stack (docker-compose only) ---------------------------------
# Grafana admin password (docker-compose interpolates ${GRAFANA_PASSWORD}).
GRAFANA_PASSWORD=changeme

# --- Logging ----------------------------------------------------------------
# Set RUST_LOG_FORMAT=json for machine-readable logs in production / log
# shippers; the default ("pretty", or anything else) uses compact human-readable
# output. Log verbosity itself follows RUST_LOG (e.g. RUST_LOG=info), falling
# back to "info".
RUST_LOG_FORMAT=pretty
